# Copy to .env and fill in the keys you need.
# Only the selected/default provider's key is required.

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# Redis used for rate limiting. Leave commented out to use redis://localhost:6379.
# Hosted example: rediss://default:<password>@<host>:<port>
# REDIS_URL=redis://localhost:6379
